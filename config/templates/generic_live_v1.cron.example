# Install only after a READY_TO_DISARM_FOR_SESSION artifact exists and the
# generic source commit is the active, attested deployment. The Python runner
# defaults to no-submit; the explicit submit flag belongs only in the separately
# activated exact-session entry.
36 9 * * 1-5 $HOME/quant-daily-report/scripts/cron_generic_live_v1.sh >> $HOME/quant-daily-report/logs/cron_generic_live_v1.log 2>&1
