server {
    listen 80;
    listen [::]:80;
    server_name _;

    client_max_body_size 10m;

    location = / {
        root /var/www/html;
        try_files /index.html =404;
    }

    location /dashboard/ {
        alias /var/www/caerus-dashboard/;
        index index.html;
        auth_basic "Caerus";
        auth_basic_user_file /etc/nginx/.htpasswd_dashboard;
        try_files $uri $uri/ /dashboard/index.html =404;
    }

    location /dashboardDEV/ {
        alias /var/www/caerus-dashboard-dev/;
        index index.html;
        auth_basic "Caerus";
        auth_basic_user_file /etc/nginx/.htpasswd_dashboard;
        try_files $uri $uri/ /dashboardDEV/index.html =404;
    }

    location = /golf {
        return 301 /golf/;
    }

    location /golf/ {
        proxy_pass http://127.0.0.1:5001/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /golf;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }
}
