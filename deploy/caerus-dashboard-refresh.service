[Unit]
Description=Refresh Caerus dashboard data from broker and artifacts
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=brettolson
Group=brettolson
WorkingDirectory=/home/brettolson/quant-daily-report
ExecStart=/home/brettolson/.venvs/quant-daily-report/bin/python3 scripts/refresh_quant_dashboard.py --repo-root /home/brettolson/quant-daily-report --output-dir /var/www/caerus-dashboard --mirror-output-dir /var/www/caerus-dashboard-dev --env-file /home/brettolson/quant-daily-report/.env --require-live-broker
TimeoutStartSec=120s
TimeoutStopSec=15s
KillMode=control-group
Nice=10
IOSchedulingClass=idle
MemoryMax=320M
TasksMax=64
