# Kill-switch API — add this location INSIDE the existing server { } block in
# deploy/caerus-dashboard.nginx (the same server that serves /dashboard/).
#
# It proxies to the localhost-only killswitch_service and reuses the SAME basic
# auth as the dashboard, so the operator's existing browser session covers it.
#
# REQUIRED design (defense in depth):
#   1. Service binds 127.0.0.1 only and REQUIRES a bearer token for engage/disengage.
#   2. The browser never holds the token. nginx injects it here (proxy_set_header
#      Authorization) after enforcing basic auth. So the only way to reach the
#      state-changing endpoint is: authenticated browser -> nginx -> service.
#   3. Because the service refuses token-less POSTs, a malicious page in the
#      operator's browser CANNOT re-arm/halt trading by POSTing directly to
#      127.0.0.1:8787 (it can't set the Authorization header cross-origin).
#
# Do NOT expose port 8787 in any firewall rule. Do NOT run the service without a token.

location /dashboard/api/killswitch {
    auth_basic "Caerus";
    auth_basic_user_file /etc/nginx/.htpasswd_dashboard;

    # strip the /dashboard prefix so the service sees /api/killswitch...
    rewrite ^/dashboard(/api/killswitch.*)$ $1 break;

    proxy_pass http://127.0.0.1:8787;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;

    # REQUIRED: inject the same token the service was started with
    # (contents of /home/brettolson/.caerus/killswitch.token). Paste it here:
    proxy_set_header Authorization "Bearer PASTE_KILLSWITCH_TOKEN_HERE";
}
